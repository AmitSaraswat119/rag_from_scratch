# ── OpenAI ──────────────────────────────────────────────────────────────────
# Required for embeddings (text-embedding-3-small) and generation (gpt-4o)
OPENAI_API_KEY=sk-...

# ── Zilliz Cloud ─────────────────────────────────────────────────────────────
# Free-tier cluster: https://cloud.zilliz.com
# URI looks like: https://in03-xxxx.api.gcp-us-west1.zilliztech.com
ZILLIZ_URI=https://your-cluster.api.region.zilliztech.com
ZILLIZ_TOKEN=your_api_token_here

# ── Optional ─────────────────────────────────────────────────────────────────
# Override the LLM model (default: gpt-4o)
# LLM_MODEL=gpt-4o-mini

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Local dev  → leave as * (open)
# Production → set to your Vercel URL + localhost
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173
CORS_ORIGINS=*
